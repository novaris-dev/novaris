{
    "name": "novaris",
    "description": "Novaris is a starter theme for the Novaris Content Management System, providing a clean and flexible foundation for building custom themes and content-driven websites.",
    "version": "0.0.1",
    "author": "Benjamin Lu",
    "license": "GPL-2.0-or-later",
    "type": "module",
    "homepage": "https://github.com/novaris-dev/novaris",
    "main": "resources/js/app.js",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/novaris-dev/novaris.git"
    },
    "bugs": {
        "url": "https://github.com/novaris-dev/novaris/issues"
    },
    "devDependencies": {
        "sass": "^1.105.0",
        "vite": "^8.3.1"
    },
    "scripts": {
        "build": "npm run prod && npm run export",
        "watch": "vite build --watch --minify=false",
        "prod": "vite build",
        "export": "node export-theme.js"
    }
}